{
    "issuers": [
        {
            "credential_issuer": "MosipOtp",
            "display": [
                {
                    "name": "UIN, VID, AID",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/mosip-logo.png",
                        "alt_text": "mosip logo"
                    },
                    "title": "Download MOSIP Credentials via OTP",
                    "description": "Download credentials by providing UIN, VID or AID",
                    "language": "en"
                },
                {
                    "name": "UIN, VID, AID",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/mosip-logo.png",
                        "alt_text": "شعار موسيب"
                    },
                    "title": "قم بتنزيل بيانات اعتماد MOSIP عبر OTP",
                    "description": "قم بتنزيل بيانات الاعتماد من خلال توفير UIN أو VID أو AID",
                    "language": "ar"
                },
                {
                    "name": "UIN, VID, AID",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/mosip-logo.png",
                        "alt_text": "मोसिप लोगो"
                    },
                    "title": "OTP के माध्यम से MOSIP क्रेडेंशियल डाउनलोड करें",
                    "description": "यूआईएन, वीआईडी या एआईडी प्रदान करके क्रेडेंशियल डाउनलोड करें",
                    "language": "hi"
                },
                {
                    "name": "UIN, VID, AID",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/mosip-logo.png",
                        "alt_text": "mosip ಲೋಗೋ"
                    },
                    "title": "OTP ಮೂಲಕ MOSIP ರುಜುವಾತುಗಳನ್ನು ಡೌನ್ಲೋಡ್ ಮಾಡಿ",
                    "description": "UIN, VID ಅಥವಾ AID ಒದಗಿಸುವ ಮೂಲಕ ರುಜುವಾತುಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ",
                    "language": "kn"
                },
                {
                    "name": "UIN, VID, AID",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/mosip-logo.png",
                        "alt_text": "mosip சின்னம்"
                    },
                    "title": "OTP வழியாக MOSIP சான்றுகளைப் பதிவிறக்கவும்",
                    "description": "UIN, VID அல்லது AID ஐ வழங்குவதன் மூலம் நற்சான்றிதழ்களைப் பதிவிறக்கவும்",
                    "language": "ta"
                },
                {
                    "name": "UIN, VID, AID",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/mosip-logo.png",
                        "alt_text": "logo ng mosip"
                    },
                    "title": "I-download ang Mga Kredensyal ng MOSIP sa pamamagitan ng OTP",
                    "description": "Mag-download ng mga kredensyal sa pamamagitan ng pagbibigay ng UIN, VID o AID",
                    "language": "fil"
                }
            ],
            "protocol": "OTP",
            "enabled": "true"
        },
        {
            "issuer_id": "Mosip",
            "credential_issuer": "Mosip",
            "credential_issuer_host": "https://${mosip.injicertify.host}/v1/certify/issuance",
            "display": [
                {
                    "name": "Veridonia National ID Department",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/veridonia-logo.png",
                        "alt_text": "a square logo of veridonia"
                    },
                    "title": "Veridonia National ID Department",
                    "description": "Download National ID credential",
                    "language": "en"
                },
                {
                    "name": "إدارة الهوية الوطنية فيريدونيا",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/veridonia-logo.png",
                        "alt_text": "شعار مربع من veridonia"
                    },
                    "title": "إدارة الهوية الوطنية فيريدونيا",
                    "description": "تحميل بطاقة الهوية الوطنية",
                    "language": "ar"
                },
                {
                    "name": "वेरिडोनिया राष्ट्रीय आईडी विभाग",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/veridonia-logo.png",
                        "alt_text": "वेरिडोनिया का एक वर्गाकार लोगो"
                    },
                    "title": "वेरिडोनिया राष्ट्रीय आईडी विभाग",
                    "description": "राष्ट्रीय आईडी क्रेडेंशियल डाउनलोड करें",
                    "language": "hi"
                },
                {
                    "name": "ವೆರಿಡೋನಿಯಾ ರಾಷ್ಟ್ರೀಯ ID ಇಲಾಖೆ",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/veridonia-logo.png",
                        "alt_text": "ವೆರಿಡೋನಿಯಾದ ಚೌಕಾಕಾರದ ಲೋಗೋ"
                    },
                    "title": "ವೆರಿಡೋನಿಯಾ ರಾಷ್ಟ್ರೀಯ ID ಇಲಾಖೆ",
                    "description": "ರಾಷ್ಟ್ರೀಯ ID ರುಜುವಾತುಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ",
                    "language": "kn"
                },
                {
                    "name": "வெரிடோனியா தேசிய அடையாளத் துறை",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/veridonia-logo.png",
                        "alt_text": "வெரிடோனியாவின் சதுர லோகோ"
                    },
                    "title": "வெரிடோனியா தேசிய அடையாளத் துறை",
                    "description": "தேசிய அடையாளச் சான்றிதழைப் பதிவிறக்கவும்",
                    "language": "ta"
                },
                {
                    "name": "Département national d'identité de Veridonia",
                    "logo": {
                        "url": "https://${mosip.api.public.host}/inji/veridonia-logo.png",
                        "alt_text": "un logo carré de veridonia"
                    },
                    "title": "Département national d'identité de Veridonia",
                    "description": "Télécharger le titre d'identité nationale",
                    "language": "fr"
                }
            ],
            "protocol": "OpenId4VCI",
            "client_id": "${mimoto.oidc.partner.clientid}",
            "client_alias": "mpartner-default-mimotooidc",
            "scopes_supported": [
                "mosip_identity_vc_ldp"
            ],
            "additional_headers": {
                "Accept": "application/json"
            },
            "wellknown_endpoint": "https://${mosip.injicertify.host}/v1/certify/issuance/.well-known/openid-credential-issuer",
            "redirect_uri": "io.mosip.residentapp.inji://oauthredirect",
            "authorization_endpoint": "https://${mosip.esignet.host}/authorize",
            "authorization_audience": "https://${mosip.esignet.host}/v1/esignet/oauth/v2/token",
            "token_endpoint": "https://${mosip.api.public.host}/residentmobileapp/get-token/Mosip",
            "proxy_token_endpoint": "https://${mosip.esignet.host}/v1/esignet/oauth/v2/token",
            "credential_endpoint": "https://${mosip.esignet.host}/v1/esignet/vci/credential",
            "credential_type": [
                "VerifiableCredential",
                "MOSIPVerifiableCredential"
            ],
            "credential_audience": "https://${mosip.esignet.host}",
            "enabled": "true"
        }
       
    ]
}
