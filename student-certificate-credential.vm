## Here we are injecting DateTool instance from java velocity library to set the expiry date
#set( $defaultLocale = $date.getLocale() )
#set( $calenderNow = $date.getCalendar() )
#set( $ISO8601DateTimeWithMillisUTC = "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'" )
#set( $ISO8601Date = "yyyy-MM-dd" )

## Certificates default to a 5-year validity window from issuance if no explicit validUpto is set.
#set( $expiry =$calenderNow.add(1,5))

#set( $formattedIssueDate = $date.toDate($ISO8601Date, $issueDate))
#set( $formattedValidUpto = $date.toDate($ISO8601Date, $validUpto))

{
  "@context": [
    "https://www.w3.org/2018/credentials/v1",
    "https://dharanidharan-s-04.github.io/mosipid-did/sunbird/studentcertificate-context.json"
  ],
  "type": [
    "VerifiableCredential",
    "StudentCertificate"
  ],
  "issuer": "${issuerId}",
  "expirationDate": "${date.format($ISO8601DateTimeWithMillisUTC, $calenderNow, $defaultLocale)}",
  "credentialSubject": {
    "studentId": "${studentId}",
    "studentName": "${studentName}",
    "institutionId": "${institutionId}",
    "institutionName": "${institutionName}",
    "program": "${program}",
    "certificateType": "${certificateType}",
    "grade": #if($grade)"${grade}"#else""#end,
    "issueDate": "${date.format($ISO8601Date, $formattedIssueDate)}",
    "validUpto": "${date.format($ISO8601Date, $formattedValidUpto)}",
    "dateOfBirth": "${dateOfBirth}",
    "batchYear": "${batchYear}",
    "certificateKey": "${certificateKey}",
    "status": "${status}"
  }
}
