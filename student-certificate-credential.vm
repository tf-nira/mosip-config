##Here we are injecting DateTool instance from java velocity library to set the expiry date
#set( $defaultLocale = $date.getLocale() )
#set( $calenderNow = $date.getCalendar() )
#set( $ISO8601DateTimeWithMillisUTC = "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'" )
## Certificates default to a 5-year validity window from issuance if no explicit validUpto is set.
## '1' represents Year and '5' represents no. of years being added
#set( $expiry =$calenderNow.add(1,5))
#set( $formattedIssueDate = $date.toDate($ISO8601DateTimeWithMillisUTC, ${issueDate}))
{
"@context": [
"https://www.w3.org/2018/credentials/v1",
"https://mosip.github.io/inji-config/contexts/studentcertificate-context.json"
],
"type": [
"VerifiableCredential",
"StudentCertificate"
],
"issuer": "${issuerId}",
"expirationDate": #if($validUpto && $validUpto != "")"${date.format('yyyy-MM-dd', $date.toDate($ISO8601DateTimeWithMillisUTC, ${validUpto}))}"#else"${date.format($ISO8601DateTimeWithMillisUTC, $calenderNow, $defaultLocale)}"#end,
"credentialSubject": {
"studentId": "${studentId}",
"studentName": "${studentName}",
"institutionName": "${institutionName}",
"program": "${program}",
"certificateType": "${certificateType}",
"grade": #if($grade)"${grade}"#else""#end,
"issueDate": "${date.format('yyyy-MM-dd', $formattedIssueDate)}"
}
}
